<Window x:Class="TextReader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Text Reader"
       Icon="/TextReaderV2;component/Assets/TextReader.ico"
        Width="980"
        Height="700"
        MinWidth="760"
        MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu Grid.Row="0" Margin="-6,-6,-6,10">
            <MenuItem Header="_File">
                <MenuItem Header="_Open text file..." Click="OpenFileMenuItem_Click"/>
                <MenuItem Header="_Save text as..." Click="SaveFileMenuItem_Click"/>
                <Separator/>
                <MenuItem Header="E_xit" Click="ExitMenuItem_Click"/>
            </MenuItem>
        </Menu>

        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="10"
                BorderBrush="LightGray"
                BorderThickness="1"
                CornerRadius="4">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="220"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Row="0" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,0,0,10">
                    <TextBlock Text="Engine:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="EngineComboBox" Width="150" SelectedIndex="0"
                              SelectionChanged="EngineComboBox_SelectionChanged">
                        <ComboBoxItem Content="Piper" Tag="piper"/>
                        <ComboBoxItem Content="Kokoro" Tag="kokoro"/>
                    </ComboBox>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="0"
                           Text="Voice:"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <ComboBox x:Name="VoiceComboBox"
                          Grid.Row="1" Grid.Column="1"
                          VerticalAlignment="Center"
                          Margin="0,0,18,0"
                          SelectionChanged="VoiceComboBox_SelectionChanged"/>

                <TextBlock Grid.Row="1" Grid.Column="2"
                           Text="Speed:"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0"/>

                <StackPanel Grid.Row="1" Grid.Column="3" Orientation="Horizontal">
                    <Slider x:Name="RateSlider"
                            Width="105"
                            Minimum="-10"
                            Maximum="10"
                            Value="0"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            ValueChanged="RateSlider_ValueChanged"/>
                    <TextBlock x:Name="RateValueText"
                               Width="30"
                               Text="0"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <TextBlock Grid.Row="1" Grid.Column="4"
                           Text="Volume:"
                           VerticalAlignment="Center"
                           Margin="18,0,6,0"/>

                <StackPanel Grid.Row="1" Grid.Column="5" Orientation="Horizontal">
                    <Slider x:Name="VolumeSlider"
                            Width="105"
                            Minimum="0"
                            Maximum="100"
                            Value="100"
                            TickFrequency="5"
                            IsSnapToTickEnabled="True"
                            ValueChanged="VolumeSlider_ValueChanged"/>
                    <TextBlock x:Name="VolumeValueText"
                               Width="30"
                               Text="100"
                               TextAlignment="Right"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Button x:Name="ConnectPiperButton"
                        Grid.Column="7"
                        Content="Connect / Start Piper"
                        MinWidth="160"
                        Height="30"
                        Background="IndianRed"
                        Foreground="White"
                        BorderBrush="DarkRed"
                        FontWeight="SemiBold"
                        ToolTip="Connects to the selected speech engine; can also start Piper"
                        Margin="0,0,0,10"
                        Click="ConnectPiperButton_Click"/>
            </Grid>
        </Border>

        <TextBox x:Name="TextInput"
                 Grid.Row="2"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled"
                 FontSize="18"
                 Padding="10"
                 SpellCheck.IsEnabled="True"/>

        <Grid Grid.Row="3" Margin="0,12,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <ProgressBar x:Name="ReadingProgress"
                         Grid.Column="0"
                         Height="18"
                         Minimum="0"
                         Maximum="1"
                         Value="0"/>

            <TextBlock x:Name="ProgressText"
                       Grid.Column="1"
                       Margin="10,0,0,0"
                       Text="0 / 0"
                       VerticalAlignment="Center"/>
        </Grid>

        <WrapPanel Grid.Row="4" Margin="0,0,0,8">
            <Button Content="Paste"
                    Width="80"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="PasteButton_Click"/>

            <Button Content="Read All"
                    Width="90"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="ReadButton_Click"/>

            <Button Content="Read Selection"
                    Width="115"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="ReadSelectionButton_Click"/>

            <Button Content="Previous"
                    Width="90"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="PreviousButton_Click"/>

            <Button Content="Pause"
                    Width="80"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="PauseButton_Click"/>

            <Button Content="Resume"
                    Width="80"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="ResumeButton_Click"/>

            <Button Content="Next"
                    Width="80"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="NextButton_Click"/>

            <Button Content="Stop"
                    Width="80"
                    Height="34"
                    Margin="0,0,8,0"
                    Click="StopButton_Click"/>

            <Button Content="Clear"
                    Width="80"
                    Height="34"
                    Click="ClearButton_Click"/>
        </WrapPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="5"
                   Text="Ready."
                   Foreground="DimGray"
                   FontSize="13"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>
